rules_version = '2';

// Avenir Housing — Firestore security rules.
// Deploy: firebase deploy --only firestore:rules   (or paste into the console)
service cloud.firestore {
  match /databases/{database}/documents {

    // An admin is any signed-in user with a document at admins/{uid}.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Listings: anyone can read (the public site), only admins can write.
    match /properties/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() < 200;
      allow delete: if isAdmin();
    }

    // Admin list: a user can check their own entry. Add/remove admins in the console.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
